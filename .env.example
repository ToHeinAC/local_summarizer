# Copy to .env and adjust. Loaded via python-dotenv.

# Ollama server (langchain-ollama reads this base URL). This is the fallback:
# the app normally talks to a GPU-pinned daemon of its own (src/ollama_server.py).
OLLAMA_HOST=http://localhost:11434

# GPU pinning for the app's own Ollama daemon (src/ollama_server.py, docs/gpu.md).
# "auto" pins to the emptiest card that fits, an integer forces that GPU index
# (note "0" is a GPU index, not an off-switch), "off" disables pinning entirely.
OLLAMA_PIN_GPU=auto
# Spare port for the pinned daemon; keep off 11434 (the shared system daemon).
OLLAMA_PIN_PORT=11435

# Streamlit port for this app.
APP_PORT=8530

# Defaults (must match ids in src/models.py and src/templates.py).
DEFAULT_MODEL=standard
DEFAULT_TEMPLATE=standard
DEFAULT_LANGUAGE=auto

# Markdown conversion (src/md_convert.py).
# OCR_MODEL must be vision-capable; it reads scanned PDF pages.
OCR_MODEL=deepseek-ocr:3b
# REWRITE_MODEL reformats digital PDF text as Markdown (wording preserved).
# A small, fast model suffices: it only adds structure, never rewords.
REWRITE_MODEL=LiquidAI/lfm2.5-1.2b-instruct:latest
# Rasterization resolution for scanned pages.
PDF_DPI=150

# Seed passwords for the two accounts in src/auth.py (SEED_USERS).
# Used only when data/users.json does not exist yet. Never commit real values.
SEED_PW_HEIN=change-me
SEED_PW_GAST=change-me
